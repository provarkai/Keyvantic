{
  "name": "keyvantic-kos",
  "version": "0.1.0",
  "private": true,
  "description": "Keyvantic Knowledge Operating System (KOS) - monorepo",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:types": "pnpm --filter=./packages/* run build",
    "dev": "pnpm run build:types && pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm run build:types && pnpm --filter=./apps/* run build",
    "lint": "pnpm --filter=./apps/* run lint",
    "typecheck": "pnpm run build:types && pnpm --filter=./apps/* run typecheck",
    "test": "pnpm --filter=./apps/* run test",
    "db:migrate": "pnpm --filter=api run prisma:migrate",
    "db:seed": "pnpm --filter=api run prisma:seed",
    "db:studio": "pnpm --filter=api run prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
