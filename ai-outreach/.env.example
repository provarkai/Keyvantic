# ─── OpenRouter (required) ───────────────────────────────────────────────
# Create a key at https://openrouter.ai/keys
# This is read server-side only and is never exposed to the browser.
OPENROUTER_API_KEY=""

# Default model used for both research and email generation.
# Any slug from https://openrouter.ai/models works.
OPENROUTER_MODEL="anthropic/claude-sonnet-5"

# Optional: a cheaper/faster model for the email-writing step.
# Falls back to OPENROUTER_MODEL when unset.
OPENROUTER_EMAIL_MODEL=""

# Optional: comma-separated allowlist of model slugs offered in the UI picker.
# Falls back to a curated built-in list when unset.
OPENROUTER_ALLOWED_MODELS=""

# ─── OpenRouter attribution (optional, recommended) ──────────────────────
# Sent as HTTP-Referer / X-Title so your app shows on openrouter.ai/rankings.
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="AI Outreach"

# ─── Behaviour toggles (optional) ────────────────────────────────────────
# Fetch the company's homepage and feed it to the model so the research is
# grounded in real copy rather than model memory. Strongly recommended.
SCRAPE_COMPANY_SITE="true"

# Enable OpenRouter's web-search plugin during research. Improves freshness
# but adds per-request cost. Off by default.
OPENROUTER_WEB_SEARCH="false"

# Requests allowed per IP per window (in-memory; per server instance).
RATE_LIMIT_MAX="20"
RATE_LIMIT_WINDOW_MS="60000"
